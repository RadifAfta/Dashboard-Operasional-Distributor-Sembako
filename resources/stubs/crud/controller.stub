<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Http\Requests\Admin\{{modelName}}Request;
use App\Models\{{modelName}};
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

class {{modelName}}Controller extends Controller
{
    /**
     * Display a listing of the resource.
     */
    public function index(Request $request): Response
    {
        ${{variableNamePlural}} = {{modelName}}::query()
            ->search($request->search)
            ->when($request->status, fn ($q, $status) => $q->where('status', $status))
            ->orderBy($request->sort_field ?? 'created_at', $request->sort_direction ?? 'desc')
            ->paginate($request->per_page ?? 10)
            ->withQueryString();

        return Inertia::render('Admin/{{modelNamePlural}}/Index', [
            'items' => ${{variableNamePlural}},
            'filters' => $request->only(['search', 'status', 'sort_field', 'sort_direction', 'per_page']),
        ]);
    }

    /**
     * Store a newly created resource in storage.
     */
    public function store({{modelName}}Request $request): RedirectResponse
    {
        {{modelName}}::create($request->validated());

        return redirect()->route('admin.{{routePrefix}}.index')
            ->with('success', 'Data {{humanName}} berhasil ditambahkan.');
    }

    /**
     * Update the specified resource in storage.
     */
    public function update({{modelName}}Request $request, {{modelName}} ${{variableNameSingular}}): RedirectResponse
    {
        ${{variableNameSingular}}->update($request->validated());

        return redirect()->route('admin.{{routePrefix}}.index')
            ->with('success', 'Data {{humanName}} berhasil diperbarui.');
    }

    /**
     * Remove the specified resource from storage.
     */
    public function destroy({{modelName}} ${{variableNameSingular}}): RedirectResponse
    {
        ${{variableNameSingular}}->delete();

        return redirect()->route('admin.{{routePrefix}}.index')
            ->with('success', 'Data {{humanName}} berhasil dihapus.');
    }

    /**
     * Remove multiple resources from storage.
     */
    public function bulkDestroy(Request $request): RedirectResponse
    {
        $validated = $request->validate([
            'ids' => ['required', 'array'],
            'ids.*' => ['integer', 'exists:{{tableName}},id'],
        ]);

        {{modelName}}::whereIn('id', $validated['ids'])->delete();

        return redirect()->route('admin.{{routePrefix}}.index')
            ->with('success', count($validated['ids']) . ' data {{humanName}} berhasil dihapus.');
    }
}
